# Uygulama Çalışma Ortamı (development, test, production)
APP_ENV=development
DEBUG=false

# Veritabanı Yapılandırması
POSTGRES_USER=kutuphane
POSTGRES_PASSWORD=kutuphane123!
POSTGRES_DB=kutuphane
DB_PORT=5433
DATABASE_URL=postgresql+psycopg://kutuphane:kutuphane123!@localhost:5433/kutuphane

# Güvenlik ve JWT (Üretim ortamında en az 32 karakterlik rastgele bir değerle değiştirin)
SECRET_KEY=gelistirme-ve-test-ortami-icin-ornek-gizli-anahtar-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false

# CORS (İzin verilen istemci adresleri, virgülle ayrılmış)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# Kütüphane İş Kuralları Yapılandırması
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS=3
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# İlk Seed Veri Parolaları (Yalnızca yerel geliştirme için, üretimde değiştirilmelidir)
SEED_ADMIN_PASSWORD=Admin12345!
SEED_STUDENT_PASSWORD=Ogrenci12345!
